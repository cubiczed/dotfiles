# config 
macos-option-as-alt = true
mouse-hide-while-typing = true

# theme
theme = Atom One Dark
background-opacity = 0.7
background-blur-radius = 20

# window
window-height = 30
window-width = 110
window-padding-x = 5 
window-decoration

# font
font-family = "MonaLisa Variable"
font-thicken= true
font-size = 13

# Set cursor style to block (all 3 lines)
cursor-style = block 
cursor-style-blink = false
shell-integration-features = no-cursor
